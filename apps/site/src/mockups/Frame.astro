---
import '../styles/global.css'
import { SITE_NAMES } from './sample.ts'

// The frame of a mockup page (issue 24). The mode script runs before the
// first paint: a stored choice wins, then the mode of the system, and dark
// when the system states none (MODE-01). The name switch is for the mockups
// only: it shows each proposed site name in place.
interface Props {
    title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang='en' data-theme='dark'>
    <head>
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1' />
        <meta name='robots' content='noindex' />
        <title>{title}</title>
        <script is:inline>
            ;(() => {
                const stored = localStorage.getItem('mode')
                const mode =
                    stored === 'light' || stored === 'dark'
                        ? stored
                        : matchMedia('(prefers-color-scheme: light)').matches
                          ? 'light'
                          : 'dark'
                document.documentElement.dataset.theme = mode
            })()
        </script>
    </head>
    <body>
        <a class='skip-link' href='#content'>
            Skip to the content
        </a>
        <slot />
        <script is:inline define:vars={{ names: SITE_NAMES }}>
            const root = document.documentElement
            const label = (mode) =>
                mode === 'dark' ? 'Switch to the light mode' : 'Switch to the dark mode'
            for (const button of document.querySelectorAll('[data-mode-switch]')) {
                button.setAttribute('aria-label', label(root.dataset.theme))
                button.addEventListener('click', () => {
                    const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
                    root.dataset.theme = next
                    localStorage.setItem('mode', next)
                    button.setAttribute('aria-label', label(next))
                })
            }
            // Without a stored choice, the page follows a change of the system.
            matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
                if (localStorage.getItem('mode') === null) {
                    root.dataset.theme = event.matches ? 'light' : 'dark'
                }
            })
            const showName = (name) => {
                for (const element of document.querySelectorAll('[data-site-name]')) {
                    element.textContent = name
                }
            }
            const storedName = localStorage.getItem('mockup-site-name')
            showName(names.includes(storedName) ? storedName : names[0])
            for (const select of document.querySelectorAll('[data-name-switch]')) {
                select.value = names.includes(storedName) ? storedName : names[0]
                select.addEventListener('change', () => {
                    localStorage.setItem('mockup-site-name', select.value)
                    showName(select.value)
                })
            }
        </script>
    </body>
</html>
