---
import Footer from '../Footer.astro'
import Header from './Header.astro'
import Newsletter from '../Newsletter.astro'
import SearchBox from '../SearchBox.astro'
import { HERO, NOTE_TYPES, RECENTLY_ADDED, RECENTLY_UPDATED, STATS, TOPICS } from '../sample.ts'

// Variant B of the home page, in the decided order (NAV-02). A band for the
// hero, topics as a cloud of chips, note types as a dense list, the stats as
// four numbers, and a filled newsletter band.
const stats = [
    { label: 'notes', value: STATS.notes },
    { label: 'links', value: STATS.links },
    { label: 'words', value: STATS.words },
    { label: 'writing since', value: STATS.since }
]
---

<Header />
<main id='content'>
    <section class='relative overflow-hidden border-b border-border bg-well'>
        <div
            class='pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-pill bg-secondary opacity-20 blur-3xl'
            aria-hidden='true'
        ></div>
        <div class='relative mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20'>
            <p class='text-sm font-semibold tracking-widest text-secondary-text uppercase'>
                A digital garden
            </p>
            <h1 class='mt-3 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl'>
                {HERO.sentence}
            </h1>
            <div class='mt-8 max-w-2xl'>
                <SearchBox hint={HERO.searchHint} large />
            </div>
        </div>
    </section>

    <div class='mx-auto max-w-5xl space-y-14 px-4 py-12 sm:px-6'>
        <section aria-labelledby='topics'>
            <h2 id='topics' class='section-title'>
                Topics
            </h2>
            <ul class='flex flex-wrap gap-2'>
                {TOPICS.map((topic) => (
                    <li>
                        <a class='chip px-4 py-2 text-base' href='#'>
                            {topic.name}
                            <span class='text-sm text-muted'>
                                {topic.count.toLocaleString('en')}
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </section>

        <section aria-labelledby='types'>
            <h2 id='types' class='section-title'>
                Note types
            </h2>
            <ul class='card grid divide-border sm:grid-cols-2 [&>li]:border-b [&>li]:border-border'>
                {NOTE_TYPES.map((type) => (
                    <li>
                        <a
                            class='flex items-center gap-4 px-5 py-4 hover:bg-surface-elevated'
                            href='#'
                        >
                            <span class='w-14 shrink-0 text-right text-lg font-bold text-primary'>
                                {type.count.toLocaleString('en')}
                            </span>
                            <span>
                                <span class='block font-semibold'>{type.name}</span>
                                <span class='block text-sm text-muted'>{type.hint}</span>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </section>

        <div class='grid gap-10 md:grid-cols-2'>
            {[
                { id: 'added', title: 'Recently added', notes: RECENTLY_ADDED },
                { id: 'updated', title: 'Recently updated', notes: RECENTLY_UPDATED }
            ].map((list) => (
                <section aria-labelledby={list.id}>
                    <h2 id={list.id} class='section-title'>
                        {list.title}
                    </h2>
                    <ol class='space-y-4'>
                        {list.notes.map((note) => (
                            <li class='flex gap-4'>
                                <time
                                    class='w-24 shrink-0 pt-0.5 text-sm text-muted'
                                    datetime={note.date}
                                >
                                    {note.date}
                                </time>
                                <a class='group' href='note'>
                                    <span class='font-semibold group-hover:underline'>
                                        {note.title}
                                    </span>
                                    <span class='block text-sm text-muted'>{note.type}</span>
                                </a>
                            </li>
                        ))}
                    </ol>
                </section>
            ))}
        </div>

        <section aria-label='Stats' class='grid grid-cols-2 gap-3 sm:grid-cols-4'>
            {stats.map((stat) => (
                <div class='card p-5'>
                    <p class='text-2xl font-bold'>{stat.value}</p>
                    <p class='text-sm text-muted'>{stat.label}</p>
                </div>
            ))}
        </section>

        <Newsletter filled />
    </div>
</main>
<Footer />
