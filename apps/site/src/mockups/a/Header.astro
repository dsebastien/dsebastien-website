---
import ModeSwitch from '../ModeSwitch.astro'
import SearchBox from '../SearchBox.astro'
import { HERO } from '../sample.ts'

// Variant A: one quiet bar. The site name leads home (NAV-01).
---

<header class='sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur'>
    <div class='mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6'>
        <a href='home' class='flex shrink-0 items-center gap-2.5 font-bold'>
            <span class='h-3 w-3 rounded-pill bg-secondary' aria-hidden='true'></span>
            <span data-site-name></span>
        </a>
        <div class='ml-auto hidden w-full max-w-sm md:block'>
            <SearchBox hint={HERO.searchHint} />
        </div>
        <button
            type='button'
            class='button-quiet ml-auto h-9 w-9 p-0 md:hidden'
            aria-label='Search'
        >
            <svg
                class='h-5 w-5'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                aria-hidden='true'
            >
                <circle cx='11' cy='11' r='7'></circle>
                <path d='m20 20-3.5-3.5'></path>
            </svg>
        </button>
        <ModeSwitch />
    </div>
</header>
