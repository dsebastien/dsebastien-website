---
import type { GetStaticPaths } from 'astro'
import { backlinksPath, typeHubPath } from '@dsebastien-website/resolver'
import latinFont from '@fontsource-variable/noto-sans/files/noto-sans-latin-wght-normal.woff2?url'
import { ctaScript } from '../../../ads/cta.ts'
import { BACKLINKS_ON_PAGE } from '../../../backlink-list.ts'
import Ad from '../../../components/Ad.astro'
import Backlinks from '../../../components/Backlinks.astro'
import NewsletterBar from '../../../components/NewsletterBar.astro'
import Outline from '../../../components/Outline.astro'
import Properties from '../../../components/Properties.astro'
import Page from '../../../layouts/Page.astro'
import { propertiesOf } from '../../../properties.ts'
import { publishedSite } from '../../../published-site.ts'
import { oldAnchorScript } from '../../../rendering/anchors.ts'
import { languageOf } from '../../../rendering/language.ts'
import { sectionBarScript } from '../../../section-bar.ts'

// The page of a published note, in variant B of the mockups (R49): a title
// band with the title, the type badge and the dates (issue 47), then three
// columns on a wide screen: the outline in the left rail, the text and the
// backlinks, and the properties panel in the right rail (issue 48, R59). On a
// small screen the panel and the outline are folding blocks above the text,
// and a bar under the header names the current section (story 8, issue 91).
// Its file has the identity of the note as its name, which is plain ASCII on
// every system and on every host. The resolver leads the canonical URL of the
// note to this file. The full text of the search indexes the title, the
// values of the properties and the text (`data-pagefind-body`, R63), with the
// label of the note type.
export const getStaticPaths = (async () => {
    const site = await publishedSite()
    return site.notes.map((note) => ({ params: { id: note.id }, props: { note, site } }))
}) satisfies GetStaticPaths

const { note, site } = Astro.props
const data = site.propertiesOf(note.vaultPath)
const body = site.pages.page(note.vaultPath)
const header = site.headerOf(note.vaultPath)
// Every property of the note is public (business rule 14). A link of a
// property is a link when its target is published (business rule 5).
const properties = propertiesOf(data, (linkPath, fragment) =>
    site.pages.linkOf(note.vaultPath, linkPath, fragment)
)
// The note page holds the first backlinks only (PAGE-03, PERF-20, PERF-26).
const backlinks = site.backlinksOf(note.vaultPath)
const shown = backlinks.slice(0, BACKLINKS_ON_PAGE)
// The ad at the end of the note, from the store catalog (AD-01).
const ad = site.adOf(note.vaultPath)
// A note that also exists on the main site names the post there as its
// original, or is noindex without a verified post (issue 55, ADR 0010).
const signals = site.signalsOf(note.vaultPath)
---

<Page
    title={site.titleOf(note.vaultPath)}
    description={site.descriptionOf(note.vaultPath)}
    path={note.path}
    {...(signals.original === undefined ? {} : { original: signals.original })}
    noindex={signals.noindex}
    lang={languageOf(data)}
    bare
>
    {/* `data-heading` keeps the text of the H1 of the note, which an old hash names (URL-14). */}
    {/* The full-text search shows the title of the title index: the fallback title when */}
    {/* two pages share one (issue 94). */}
    {/* The text of the page uses this file: a late font moves the text (PERF-20, R57). */}
    <link slot='head' rel='preload' href={latinFont} as='font' type='font/woff2' crossorigin />
    <div class='border-b border-border bg-well'>
        <div class='mx-auto max-w-7xl px-4 py-6 sm:px-6'>
            <h1
                id={body.heading?.id}
                data-note-title
                data-heading={body.heading?.text}
                data-pagefind-body
                data-pagefind-meta={`title:${header.title}`}
                class='max-w-4xl text-3xl font-bold tracking-tight break-words sm:text-5xl'
            >
                {header.heading}
            </h1>
            <p class='mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted'>
                {header.type !== undefined && (
                    <a
                        class='badge-link'
                        href={typeHubPath(header.type.name, 1)}
                        aria-label={`${header.type.one}, all notes of this type`}
                        data-type-badge
                        data-pagefind-meta='type'
                    >
                        <span class='badge'>{header.type.one}</span>
                    </a>
                )}
                <span>
                    Created <time datetime={header.created.datetime}>{header.created.shown}</time>
                </span>
                <span>
                    Updated <time datetime={header.updated.datetime}>{header.updated.shown}</time>
                </span>
            </p>
        </div>
    </div>
    {/* The bar of the current section comes before the parts of the note, as it */}
    {/* shows above them: the keyboard reaches it first. It is fixed, so it moves nothing. */}
    {body.outline !== undefined && (
        <button type='button' class='section-bar' data-section-bar hidden>
            <span class='shrink-0 text-muted'>On this page</span>
            <span class='truncate' data-section-bar-text></span>
        </button>
    )}
    <div class='note-layout'>
        {body.outline !== undefined && (
            <nav class='note-outline' aria-label='On this page' data-outline='rail'>
                <div class='rail'>
                    <p class='section-title'>On this page</p>
                    <Outline items={body.outline} />
                </div>
            </nav>
        )}
        {properties.length > 0 && (
            <aside class='note-properties' aria-label='Properties'>
                <div class='rail'>
                    <Properties properties={properties} />
                </div>
            </aside>
        )}
        <div class='note-main'>
            {body.outline !== undefined && (
                <details class='fold group mb-8 lg:hidden' data-outline='fold'>
                    <summary class='fold-summary'>
                        <span>On this page</span>
                        <span
                            class='ml-auto text-muted transition-transform group-open:rotate-180'
                            aria-hidden='true'
                        >
                            ▾
                        </span>
                    </summary>
                    <nav class='border-t border-border px-2 py-3' aria-label='On this page'>
                        <Outline items={body.outline} />
                    </nav>
                </details>
            )}
            <article
                class='note-text max-w-[72ch]'
                data-note-body
                data-pagefind-body
                set:html={body.html}
            />
            {ad.length > 0 && <Ad products={ad} page={note.vaultPath} />}
            {backlinks.length > 0 && (
                <section
                    class='mt-12 max-w-[72ch]'
                    aria-label='Notes that link here'
                    data-backlinks
                >
                    <h2 class='section-title'>
                        Notes that link here <span class='ml-1'>{backlinks.length}</span>
                    </h2>
                    <Backlinks backlinks={shown} />
                    {backlinks.length > shown.length && (
                        <p class='mt-4'>
                            <a class='link-control' href={backlinksPath(note.id)}>
                                All {backlinks.length} notes that link here
                            </a>
                        </p>
                    )}
                </section>
            )}
        </div>
    </div>
    {body.outline !== undefined && <script is:inline set:html={sectionBarScript} />}
    {/* The newsletter bar, on note pages only (NEWS-01). */}
    <NewsletterBar />
    <script is:inline set:html={oldAnchorScript} />
    {ad.length > 0 && <script is:inline set:html={ctaScript} />}
</Page>
