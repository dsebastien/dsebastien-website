---
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import latinFont from '@fontsource-variable/noto-sans/files/noto-sans-latin-wght-normal.woff2?url'
import { readPublishedNotes } from '../../../content-store.ts'
import Page from '../../../layouts/Page.astro'
import { noteHeader } from '../../../note-header.ts'
import { oldAnchorScript } from '../../../rendering/anchors.ts'
import { languageOf } from '../../../rendering/language.ts'
import { SitePages } from '../../../rendering/page.ts'

// The page of a published note (issue 47), in variant B of the mockups (R49):
// a title band with the title, the type badge and the dates, then the text of
// the note. Its file has the identity of the note as its name, which is plain
// ASCII on every system and on every host. The resolver leads the canonical
// URL of the note to this file.
export const getStaticPaths = (async () => {
    const entries = new Map((await getCollection('notes')).map((entry) => [entry.id, entry]))
    const notes = await readPublishedNotes()
    const site = notes.map((note) => {
        const entry = entries.get(note.vaultPath)
        if (entry === undefined) {
            throw new Error(`the content store has no cleaned note for "${note.vaultPath}"`)
        }
        if (entry.rendered === undefined) {
            throw new Error(`the note "${note.vaultPath}" has no markup`)
        }
        return { note, entry, markup: entry.rendered.html }
    })
    // The pages of this build (BUILD-05): the markup of each note, which Astro
    // keeps between two builds, with its links and its embeds in the state of
    // this build.
    const pages = new SitePages(
        site.map(({ note, markup }) => ({
            vaultPath: note.vaultPath,
            path: note.path,
            markup,
            links: new Map(note.links.map((link) => [link.link, link.path])),
            files: new Map(note.attachments.map((file) => [file.link, file]))
        }))
    )
    return site.map(({ note, entry }) => ({
        params: { id: note.id },
        props: { note, properties: entry.data, language: languageOf(entry.data), pages }
    }))
}) satisfies GetStaticPaths

const { note, properties, language, pages } = Astro.props
const body = pages.page(note.vaultPath)
const header = noteHeader({
    fileName: note.title,
    properties,
    ...(body.heading === undefined ? {} : { firstHeading: body.heading.text }),
    firstPublished: note.firstPublished,
    lastPublished: note.lastPublished
})
---

<Page title={header.title} path={note.path} lang={language} bare>
    {/* `data-heading` keeps the text of the H1 of the note, which an old hash names (URL-14). */}
    {/* The text of the page uses this file: a late font moves the text (PERF-20, R57). */}
    <link slot='head' rel='preload' href={latinFont} as='font' type='font/woff2' crossorigin />
    <div class='border-b border-border bg-well'>
        <div class='mx-auto max-w-7xl px-4 py-8 sm:px-6'>
            <h1
                id={body.heading?.id}
                data-note-title
                data-heading={body.heading?.text}
                class='max-w-4xl text-3xl font-bold tracking-tight break-words sm:text-5xl'
            >
                {header.title}
            </h1>
            <p class='mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted'>
                {header.type !== undefined && <span class='badge'>{header.type}</span>}
                <span>
                    Created <time datetime={header.created.datetime}>{header.created.shown}</time>
                </span>
                <span>
                    Updated <time datetime={header.updated.datetime}>{header.updated.shown}</time>
                </span>
            </p>
        </div>
    </div>
    <div class='mx-auto w-full max-w-7xl px-4 py-10 sm:px-6'>
        <article class='note-text max-w-[72ch]' data-note-body set:html={body.html} />
    </div>
    <script is:inline set:html={oldAnchorScript} />
</Page>
