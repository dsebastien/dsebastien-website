---
import Page from '../../layouts/Page.astro'
import { publishedSite } from '../../published-site.ts'

// The library (NAV-03, decision R61): the type hubs of the media types, the
// types whose type tag is under `type/media/` in the vault. It is indexed, as
// a curated list (IDX-22); its H1 is the main part of its title (IDX-07).
const site = await publishedSite()
const library = site.library
---

<Page title={library.title} description={library.description} path={library.path}>
    <p class='section-title'>Type hubs</p>
    <h1 class='text-3xl font-bold tracking-tight sm:text-4xl'>Library</h1>
    <p class='mt-2 max-w-2xl text-muted'>The movies, shows and games of these notes.</p>
    <ul class='mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3' data-library>
        {library.hubs.map((hub) => (
            <li>
                <a class='card-link h-full' href={hub.pages[0]?.path}>
                    <span class='font-semibold'>{hub.label}</span>
                    <span class='mt-1 block text-sm text-muted'>
                        {hub.count.toLocaleString('en')} {hub.count === 1 ? 'note' : 'notes'}
                    </span>
                </a>
            </li>
        ))}
    </ul>
</Page>
