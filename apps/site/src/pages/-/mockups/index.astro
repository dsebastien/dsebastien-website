---
import Frame from '../../../mockups/Frame.astro'
import ModeSwitch from '../../../mockups/ModeSwitch.astro'
import NameSwitch from '../../../mockups/NameSwitch.astro'

// The index of the mockups of issue 24 (PROTO-06). Prototype branch only.
const variants = [
    {
        id: 'a',
        name: 'A: Reading room',
        text: 'A quiet bar and one centered reading column. The outline is a side column; the author line is under the title; cite and share close the text.'
    },
    {
        id: 'b',
        name: 'B: Atlas',
        text: 'A title band and side rails. The outline is on the left; the author, cite and share stay on the right on wide screens. Denser lists and a filled newsletter band.'
    }
]
---

<Frame title='Mockups of the notes site'>
    <main id='content' class='mx-auto max-w-3xl px-4 py-12 sm:px-6'>
        <div class='flex flex-wrap items-center justify-between gap-4'>
            <h1 class='text-3xl font-bold'>Mockups of the notes site</h1>
            <div class='flex items-center gap-3'>
                <NameSwitch />
                <ModeSwitch />
            </div>
        </div>
        <p class='mt-4 text-muted'>
            Two variants of the home page and of the note page, in the theme <code>knowii</code>.
            The switches above change the site name and the mode on every page; your choice is kept.
            All the content is invented.
        </p>
        <ul class='mt-8 space-y-4'>
            {variants.map((variant) => (
                <li class='card p-5'>
                    <h2 class='text-xl font-bold'>{variant.name}</h2>
                    <p class='mt-1 text-muted'>{variant.text}</p>
                    <p class='mt-3 flex flex-wrap gap-2'>
                        <a class='button' href={`${variant.id}/home`}>
                            Home page
                        </a>
                        <a class='button-quiet' href={`${variant.id}/note`}>
                            Note page
                        </a>
                        <a class='button-quiet' href={`${variant.id}/book`}>
                            Book note page
                        </a>
                    </p>
                </li>
            ))}
        </ul>
        <section class='mt-10'>
            <h2 class='section-title'>What to look at</h2>
            <ol class='list-decimal space-y-2 pl-6'>
                <li>The site name, in the header and in the titles.</li>
                <li>
                    The display title: the file is "Zettelkasten (Permanent)", the page shows the
                    first heading.
                </li>
                <li>
                    The places of the author line, the "cite this note" block and the share row.
                </li>
                <li>The key facts box of a media note, on the book note page.</li>
                <li>
                    Both modes, and a small window (the outline becomes a bar or a closed list).
                </li>
            </ol>
        </section>
    </main>
</Frame>
