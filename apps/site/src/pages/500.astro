---
import Page from '../layouts/Page.astro'
// After the layout: the mode of the system wins over the dark values of `:root`.
import '../styles/themes/aurora-system.css'
import { fullTitle } from '../page-titles.ts'

// The server error page (URL-33, NAV-20, decision R64): status 500, never
// cached. One static file: no script, no detail of the failure, and the
// integration `selfContainedPages()` puts its style into the file and leaves
// out the fonts, so it shows also when another file of the release is
// missing. It follows the mode of the system.
---

<Page title={fullTitle('Server error')} noindex scriptless>
    <div class='max-w-3xl py-12'>
        <h1 class='text-3xl font-bold'>Server error</h1>
        <p class='mt-4 text-muted'>The site could not give this page. Try again in a moment.</p>
        <p class='mt-6'>
            <a class='button' href='/'>
                Go to the home page
            </a>
        </p>
    </div>
</Page>
