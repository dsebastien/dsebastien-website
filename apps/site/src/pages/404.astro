---
import Page from '../layouts/Page.astro'

// The "not found" page (URL-26 of the spec). The search suggestions come with
// the search slice.
---

<Page title='Not found' noindex>
    <div class='max-w-2xl py-12'>
        <h1 class='text-3xl font-bold'>Not found</h1>
        <p class='mt-4 text-muted'>No note has this address.</p>
        <p class='mt-6'>
            <a class='button' href='/'>
                Go to the home page
            </a>
        </p>
    </div>
</Page>
