---
// The switch of the mode (NAV-01, MODE-01). The icon shows the mode that a
// click gives: a sun in the dark mode, a moon in the light mode. It is
// hidden until its script runs: without JavaScript it could do nothing.
---

<button
    type='button'
    class='button-quiet h-11 w-11 p-0 sm:not-any-pointer-coarse:h-9 sm:not-any-pointer-coarse:w-9'
    data-mode-switch
    hidden
    aria-label='Switch the mode'
>
    <svg
        class='hidden h-5 w-5 dark:block'
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='2'
        aria-hidden='true'
    >
        <circle cx='12' cy='12' r='4'></circle>
        <path d='M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4'></path>
    </svg>
    <svg
        class='hidden h-5 w-5 light:block'
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='2'
        aria-hidden='true'
    >
        <path d='M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z'></path>
    </svg>
</button>
