---
import ModeSwitch from './ModeSwitch.astro'
import { SITE_NAME } from '../site.ts'

// The header of every page, from variant B of the mockups (R49): the site
// name leads home, and the switch of the mode (NAV-01, MODE-01). The search
// comes with its slice (issue 51).
---

<header class='sticky top-0 z-40 border-b border-border bg-surface'>
    <div class='mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6'>
        <a href='/' class='flex shrink-0 items-center gap-2.5 text-lg font-bold'>
            <span
                class='flex h-8 w-8 items-center justify-center rounded-control bg-secondary text-sm text-on-secondary'
                aria-hidden='true'
            >
                S
            </span>
            <span>{SITE_NAME}</span>
        </a>
        <div class='ml-auto flex items-center gap-2'>
            <ModeSwitch />
        </div>
    </div>
</header>
