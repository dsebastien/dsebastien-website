---
import { SEARCH_PATH } from '@dsebastien-website/resolver'
import DesignSwitch from './DesignSwitch.astro'
import ModeSwitch from './ModeSwitch.astro'
import PaletteLoader from './PaletteLoader.astro'
import logo from '../icons/icon.svg?raw'
import { SITE_NAME } from '../site.ts'

// The header of every page, from variant B of the mockups (R49): the site
// name leads home, the search control, and the switch of the mode (NAV-01,
// MODE-01). The search control is a link to the search page (SRCH-08): with
// its script, it opens the command palette on the same page, which loads at
// its first opening (issue 122, R57). On a small screen the link shows its
// icon, and its name stays. The controls are 44 px high, for a finger; with a
// mouse and no touch screen, 36 px from the small breakpoint (issue 100,
// point 3; issue 91, R95).
// The switch comes first: it is hidden until its script runs, and it shows in
// the free space at the left, so nothing moves (CLS, R57). On a very small
// screen the site name gives way with an ellipsis, so nothing goes past the edge.
// The logo is the mark of the main site (issue 133), the icon of the site: it
// is in the page, with its size, so it costs no request and moves nothing,
// and the server error page keeps it (NAV-20). It has its own background, so
// it shows the same in both modes. The site name is the name of the link.
// The switch of the theme (DES-10, R107) comes before the switch of the
// mode, hidden until its script runs, as that switch.
interface Props {
    /** False on a page with no script: the switch and the palette need their scripts (NAV-20). */
    modeSwitch?: boolean
}

const { modeSwitch = true } = Astro.props
const mark = logo.replace(
    '<svg ',
    '<svg width="32" height="32" aria-hidden="true" focusable="false" class="block" '
)
const searching = Astro.url.pathname === SEARCH_PATH || Astro.url.pathname === '/-/search.html'
---

<header class='site-header'>
    <div class='mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6'>
        <a href='/' class='flex min-h-11 min-w-0 items-center gap-2.5 text-lg font-bold'>
            <span class='h-8 w-8 shrink-0 overflow-hidden rounded-control' set:html={mark} />
            <span class='display truncate'>{SITE_NAME}</span>
        </a>
        <div class='ml-auto flex shrink-0 items-center gap-2'>
            {modeSwitch && <DesignSwitch />}
            {modeSwitch && <ModeSwitch />}
            <a
                class='button-quiet h-11 min-w-11 px-2 sm:px-3 sm:not-any-pointer-coarse:h-9 sm:not-any-pointer-coarse:min-w-9'
                href={SEARCH_PATH}
                aria-current={searching ? 'page' : undefined}
                data-search-link
                data-palette
            >
                <svg
                    class='h-5 w-5'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='2'
                    aria-hidden='true'
                >
                    <circle cx='11' cy='11' r='7'></circle>
                    <path d='m20 20-3.5-3.5'></path>
                </svg>
                <span class='sr-only sm:not-sr-only'>Search</span>
            </a>
        </div>
    </div>
    {modeSwitch && <PaletteLoader />}
</header>
