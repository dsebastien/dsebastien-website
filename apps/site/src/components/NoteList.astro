---
import type { ListPage, NoteList } from '../generated-pages.ts'

// One page of a list: a type hub, a tag page, the notes with no type
// (NAV-03, NAV-04, decision R61) or a recent list (NAV-05, R62). Its notes
// from A to Z, or newest first with their dates for a recent list; the child
// tags of a tag on its page 1; the filter of a recent list; and a link to
// every page of the list, so that a note is at most three links from the home
// page (NAV-07).
interface Props {
    list: NoteList
    page: ListPage
}

const { list, page } = Astro.props
const pages = list.pages.length
const notes = `${list.count.toLocaleString('en')} ${list.count === 1 ? 'note' : 'notes'}`
const cut =
    list.total !== undefined && list.total > list.count
        ? `${list.count.toLocaleString('en')} newest of ${list.total.toLocaleString('en')} notes`
        : undefined
const order = list.kind === 'recent' ? 'newest first' : 'from A to Z'
const summary = `${cut ?? `${notes}, ${order}`}${pages > 1 ? `, page ${String(page.number)} of ${String(pages)}` : ''}.`
---

<p class='section-title'>
    {{ type: 'Type hub', tag: 'Tag', other: 'Notes', recent: 'Recent notes' }[list.kind]}
</p>
<h1 class='text-3xl font-bold tracking-tight break-words sm:text-4xl' data-list-title>
    {list.label}
</h1>
<p class='mt-2 text-muted' data-list-count>
    {summary}
</p>
{page.children.length > 0 && (
    <nav class='mt-6 flex flex-wrap gap-2' aria-label='Nested tags' data-child-tags>
        {page.children.map((child) => (
            <a class='chip' href={child.path}>
                {child.label}
            </a>
        ))}
    </nav>
)}
{list.filters.length > 0 && (
    <details class='fold mt-6' open={list.key.includes('/')} data-filters>
        <summary class='fold-summary'>
            <span>Filter by note type</span>
            <span class='ml-auto text-sm font-normal text-muted'>{list.filters.length - 1}</span>
        </summary>
        <nav class='flex flex-wrap gap-2 px-5 pb-4' aria-label='Filter by note type'>
            {list.filters.map((filter) =>
                filter.path === page.path ? (
                    <span class='chip-current' aria-current='page'>
                        {filter.label}
                    </span>
                ) : filter.path === list.pages[0]?.path ? (
                    <a class='chip-current' href={filter.path} aria-current='true'>
                        {filter.label}
                    </a>
                ) : (
                    <a class='chip' href={filter.path}>
                        {filter.label}
                    </a>
                )
            )}
        </nav>
    </details>
)}
{(() => {
    const List = list.kind === 'recent' ? 'ol' : 'ul'
    const when = list.key.startsWith('added') ? 'Added' : 'Changed'
    return (
        <List class='mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3' data-list>
            {page.notes.map((note) => (
                <li>
                    <a class='card-link h-full' href={note.path} data-listed-note>
                        <span class='font-semibold break-words'>{note.title}</span>
                        {(list.kind === 'tag' || list.kind === 'recent') &&
                            (note.type !== undefined || note.date !== undefined) && (
                                <span class='mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted'>
                                    {note.type !== undefined && (
                                        <span class='badge'>{note.type.one}</span>
                                    )}
                                    {note.date !== undefined && (
                                        <span data-listed-when>
                                            {when}{' '}
                                            <time datetime={note.date.datetime} data-listed-date>
                                                {note.date.shown}
                                            </time>
                                        </span>
                                    )}
                                </span>
                            )}
                    </a>
                </li>
            ))}
        </List>
    )
})()}
{pages > 1 && (
    <nav class='mt-10 flex flex-wrap gap-2' aria-label='Pages' data-list-pages>
        {list.pages.map((other) =>
            other.number === page.number ? (
                <span class='chip-current' aria-current='page'>
                    {other.number}
                </span>
            ) : (
                <a class='chip' href={other.path}>
                    {other.number}
                </a>
            )
        )}
    </nav>
)}
