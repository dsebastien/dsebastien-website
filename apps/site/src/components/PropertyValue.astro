---
import type { Scalar } from '../properties.ts'

// One value of the properties panel (issue 48, PAGE-02): a text with its
// links, a number, a truth value, a date or an object as JSON. The full text
// of the search leaves out a truth value, a date and JSON: every note has them,
// so they would answer any search (R63).
interface Props {
    value: Scalar
}

const { value } = Astro.props
---

{value.kind === 'text' &&
    value.pieces.map((piece) =>
        piece.kind === 'link' || piece.kind === 'tag' ? (
            <a class='link' href={piece.href}>
                {piece.text}
            </a>
        ) : piece.kind === 'external' ? (
            <a class='link' href={piece.href} target='_blank' rel='noopener noreferrer'>
                {piece.text}
            </a>
        ) : piece.kind === 'not-published' ? (
            <span class='not-published'>{piece.text}</span>
        ) : (
            piece.text
        )
    )}
{value.kind === 'number' && <span class='font-mono'>{value.text}</span>}
{value.kind === 'boolean' && <span data-pagefind-ignore>{value.text}</span>}
{value.kind === 'date' && (
    <time datetime={value.datetime} data-pagefind-ignore>
        {value.text}
    </time>
)}
{value.kind === 'json' && (
    <pre class='properties-json' data-pagefind-ignore set:text={value.text} />
)}
