// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`rendering of the Markdown forms on the site wikilink-note: A wikilink to a published note is a link (REN-01). 1`] = `
"<h1 id="link-to-a-note">Link to a note</h1>
<p>Read <a href="/10+Garden/Compost+basics">Compost basics</a> before you start.</p>"
`;

exports[`rendering of the Markdown forms on the site wikilink-heading: A wikilink to a heading leads to that heading; without a label it shows the note and the heading, as in Obsidian (REN-01, URL-14). 1`] = `
