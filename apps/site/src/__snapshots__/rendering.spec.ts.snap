exports[`rendering of the Markdown forms on the site footnotes: Footnotes and inline footnotes (REN-01). 1`] = `
"<h1 id="footnotes">Footnotes</h1>
<p>Mulch keeps water in the soil.<sup><a href="#user-content-fn-1" id="user-content-fnref-1" data-footnote-ref="" aria-describedby="footnote-label">1</a></sup> Straw works too.<sup><a href="#user-content-fn-inline-1" id="user-content-fnref-inline-1" data-footnote-ref="" aria-describedby="footnote-label">2</a></sup></p>
<section data-footnotes="" class="footnotes"><h2 class="sr-only" id="footnote-label">Footnotes</h2>
<ol>
<li id="user-content-fn-1">
<p>Wood chips last longer. <a href="#user-content-fnref-1" data-footnote-backref="" aria-label="Back to reference 1" class="data-footnote-backref">↩</a></p>
</li>
<li id="user-content-fn-inline-1">
<p>Hay has seeds. <a href="#user-content-fnref-inline-1" data-footnote-backref="" aria-label="Back to reference 2" class="data-footnote-backref">↩</a></p>
</li>
</ol>
</section>"
`;

exports[`rendering of the Markdown forms on the site highlights: Highlights (REN-01). 1`] = `
"<h1 id="highlights">Highlights</h1>
<p>Water <mark>at dawn</mark> only, not <mark>at noon</mark>.</p>"
`;

exports[`rendering of the Markdown forms on the site math-inline: Inline math, class-based with no inline style (REN-01, REN-06). 1`] = `
