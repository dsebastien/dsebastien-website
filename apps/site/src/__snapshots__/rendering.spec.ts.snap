exports[`rendering of the Markdown forms on the site embed-note: An embed of a note shows the text of that note (REN-01). 1`] = `
"<h1 id="embed-of-a-note">Embed of a note</h1>
<div class="note-embed" data-embed-of="/10+Garden/Compost+basics"><h1>Compost basics</h1>
<p>A heap needs green matter, brown matter, air and water.</p>
<ul>
<li>Turn the heap every two weeks.</li>
<li>Keep it as wet as a wrung sponge.</li>
<li>Water it from the <a href="/10+Garden/Rain+barrel">Rain barrel</a> when the summer is dry.</li>
</ul>
<p>The herbs that like compost are in <a href="/10+Garden/Herb+bed/Herb+bed">the herb bed</a>.</p></div>"
`;

exports[`rendering of the Markdown forms on the site embed-heading: An embed of a heading shows that section only (REN-01). 1`] = `
