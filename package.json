{
    "name": "dsebastien-website",
    "private": true,
    "version": "0.0.0",
    "description": "One codebase for dsebastien.net: public notes, blog and store",
    "author": "Sébastien Dubois",
    "license": "MIT",
    "type": "module",
    "packageManager": "bun@1.4.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dsebastien/dsebastien-website.git"
    },
    "scripts": {
        "tsc": "tsc --noEmit",
        "tsc:watch": "tsc --noEmit --watch --preserveWatchOutput",
        "tscw": "bun run tsc:watch",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "bun test --isolate",
        "test:watch": "bun test --isolate --watch"
    },
    "devDependencies": {
        "@types/bun": "1.4.0",
        "@types/node": "24.10.1",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3"
    }
}
