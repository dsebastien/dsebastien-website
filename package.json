{
    "name": "dsebastien-website",
    "private": true,
    "version": "0.0.0",
    "description": "The website of my public notes, and the tool that publishes notes to it from Obsidian",
    "author": "Sébastien Dubois",
    "license": "MIT",
    "type": "module",
    "packageManager": "bun@1.4.4",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dsebastien/dsebastien-website.git"
    },
    "scripts": {
        "setup": "git config --local --replace-all include.path ../.gitconfig",
        "tsc": "tsc --noEmit",
        "tsc:watch": "tsc --noEmit --watch --preserveWatchOutput",
        "tscw": "bun run tsc:watch",
        "check": "bun run --cwd apps/site check",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "bun test --isolate",
        "test:watch": "bun test --isolate --watch",
        "rust:format": "cargo fmt --all",
        "rust:format:check": "cargo fmt --all --check",
        "rust:lint": "cargo clippy --workspace --all-targets --locked -- --deny warnings",
        "rust:test": "cargo test --workspace --locked",
        "build": "bun run build:site && bun run build:plugin",
        "build:site": "bun run --cwd apps/site build",
        "build:plugin": "bun run --cwd apps/plugin build",
        "dev": "bun run --cwd apps/site dev",
        "dev:plugin": "bun run --cwd apps/plugin dev",
        "serve": "bun run --cwd apps/site serve",
        "site:fixture": "bun scripts/site-fixture.ts",
        "plugin:vault": "bun scripts/plugin-vault.ts",
        "budgets": "bun scripts/page-budgets.ts",
        "budgets:search": "bun scripts/search-budget.ts",
        "commit:lint": "commitlint --edit",
        "corpus": "bun scripts/generate-corpus.ts",
        "corpus:published": "bun scripts/export-published.ts"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@commitlint/types": "21.2.3",
        "@dsebastien-website/resolver": "workspace:*",
        "@dsebastien-website/testing": "workspace:*",
        "@eslint/js": "10.0.1",
        "@types/bun": "1.4.0",
        "@types/node": "24.10.1",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-astro": "3.2.1",
        "globals": "17.14.0",
        "jiti": "2.7.0",
        "lighthouse": "13.6.0",
        "pagefind": "1.6.0",
        "prettier": "^3.6.2",
        "prettier-plugin-astro": "1.1.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "8.72.2"
    }
}
