# Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.iml
.idea
*.sw?
*~

# Dependencies
node_modules

# Build output
dist/
out/
build/
.astro/
target/
*.map

# Exported content. The export step writes public notes and attachments here.
# Content never enters this repository: it is public, the vault is private.
.content/
.cache/

# Private working files: analytics exports, vault analysis, raw reports.
# The repository is public. Nothing in here is ever committed.
.private/

# Secrets
.env
.env.*
!.env.example

# Code coverage
coverage/
*.lcov

# Logs
logs/
*.log

# System files
.DS_Store
Thumbs.db
Desktop.ini
.fuse_hidden*
.nfs*
