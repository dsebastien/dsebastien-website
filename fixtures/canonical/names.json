        },
        {
            "name": "another Unicode form and letter case",
            "one": "CAF\u00c9",
            "two": "cafe\u0301",
            "equal": true
        },
        {
            "name": "two different texts",
            "one": "Notes/One",
            "two": "Notes/Two",
            "equal": false
        },
        {
