    "obsidian": [
        {
            "name": "a plain path",
            "text": "Folder/Note.md",
            "path": "Folder/Note.md"
        },
        {
            "name": "a no-break space becomes a space",
            "text": "Explore and\u00a0Master.md",
            "path": "Explore and Master.md"
        },
        {
            "name": "a narrow no-break space becomes a space",
            "text": "a\u202fb.md",
            "path": "a b.md"
        },
        {
            "name": "a figure space stays",
            "text": "a\u2007b.md",
            "path": "a\u2007b.md"
        },
        {
            "name": "a folder with a no-break space",
            "text": "My\u00a0Folder/Note.md",
            "path": "My Folder/Note.md"
        },
        {
            "name": "a decomposed name is composed",
            "text": "Cafe\u0301.md",
            "path": "Caf\u00e9.md"
        },
        {
            "name": "a composed name stays",
            "text": "Caf\u00e9.md",
            "path": "Caf\u00e9.md"
        },
        {
            "name": "decomposed Hangul is composed",
            "text": "\u1100\u1161.md",
            "path": "\uac00.md"
        },
        {
            "name": "a no-break space before a combining mark becomes a space, and the mark stays",
            "text": "a\u00a0\u0301.md",
            "path": "a \u0301.md"
        },
        {
            "name": "a backslash is a slash",
            "text": "a\\b.md",
            "path": "a/b.md"
        },
        {
            "name": "slashes and backslashes in a row are one slash",
            "text": "a\\/\\b.md",
            "path": "a/b.md"
        },
        {
            "name": "the slashes at the two ends go",
            "text": "/a/b.md/",
            "path": "a/b.md"
        },
        {
            "name": "an empty path is the root",
            "text": "",
            "path": "/"
        }
    ],
    "twins": [
        {
            "name": "no two paths have one Obsidian path",
            "paths": ["A.md", "B.md"],
            "twins": {}
        },
        {
            "name": "a no-break space and a space",
            "paths": ["X Y.md", "X\u00a0Y.md"],
