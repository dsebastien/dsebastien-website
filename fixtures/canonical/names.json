        },
        {
            "name": "three paths: each names the first other one in the order of the code points",
            "paths": ["a b.md", "a\u00a0b.md", "a\u202fb.md"],
            "twins": { "a b.md": "a\u00a0b.md", "a\u00a0b.md": "a b.md", "a\u202fb.md": "a b.md" }
        },
        {
            "name": "a decomposed name and its composed form",
            "paths": ["Caf\u00e9.md", "Cafe\u0301.md"],
            "twins": { "Cafe\u0301.md": "Caf\u00e9.md", "Caf\u00e9.md": "Cafe\u0301.md" }
        },
        {
            "name": "two folders with one Obsidian path",
            "paths": ["A B/n.md", "A\u00a0B/n.md", "A B/m.md"],
            "twins": { "A B/n.md": "A\u00a0B/n.md", "A\u00a0B/n.md": "A B/n.md" }
        },
        {
            "name": "another letter case is not the same path for Obsidian",
            "paths": ["a.md", "A.md"],
            "twins": {}
