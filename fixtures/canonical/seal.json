        {
            "name": "export, spaces and double quotes",
            "text": "  export VAULT_PUBLISH_SEAL_KEY = \"abc\"  \n",
            "value": "abc"
        },
        {
            "name": "single quotes and Windows line ends",
            "text": "VAULT_PUBLISH_SEAL_KEY='abc'\r\nB=2\r\n",
            "value": "abc"
        },
        { "name": "a comment is no line", "text": "# VAULT_PUBLISH_SEAL_KEY=abc\n", "value": null },
        {
            "name": "the last line of the name wins",
            "text": "VAULT_PUBLISH_SEAL_KEY=one\nVAULT_PUBLISH_SEAL_KEY=two\n",
            "value": "two"
        },
        {
            "name": "another name that starts the same",
            "text": "VAULT_PUBLISH_SEAL_KEY_OLD=abc\n",
            "value": null
        },
        { "name": "an empty value", "text": "VAULT_PUBLISH_SEAL_KEY=\n", "value": "" },
        { "name": "one quote is kept", "text": "VAULT_PUBLISH_SEAL_KEY=\"abc\n", "value": "\"abc" }
