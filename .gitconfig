# Git configuration of this repository, with config-based hooks (Git 2.54 or later).
#
# Activate it one time per clone:
#
#   bun run setup
#
# (It runs `git config --local --replace-all include.path ../.gitconfig`. The
# path is relative to `.git/`, so `../.gitconfig` is this file.)
#
# After that, the hooks below run on each `git commit` and `git push`. Never
# bypass them.

# This repository is public. The check refuses a file of the private folders,
# a vault file outside the fixture vault, a file of the fixture vault that its
# catalog does not declare, and a symbolic link (`scripts/private-files.ts`).
#
# Before a commit and before the commit of a merge, it reads the index.
[hook "private-files"]
    event = pre-commit
    event = pre-merge-commit
    command = bun scripts/private-files.ts

# Before a push, it reads each commit that the push sends. A cherry-pick, a
# rebase and a commit from a clone without these hooks run no pre-commit hook,
# so the push is the last door of the machine.
[hook "private-files-pushed"]
    event = pre-push
    command = bun scripts/private-files.ts --pushed

[hook "format-staged"]
    event = pre-commit
    command = scripts/git-hooks/format-staged.sh

[hook "commitlint"]
    event = commit-msg
    # Git adds the path of the commit message file as the last argument. It
    # becomes the value of --edit.
    command = bunx commitlint --edit
