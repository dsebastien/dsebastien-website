# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Diff hints
*.css diff=css
*.html diff=html
*.md diff=markdown
*.ts diff=typescript
*.json diff=json

# These files are text and should be normalized (Convert crlf => lf)
*.astro text eol=lf
*.bash text eol=lf
*.css text eol=lf
*.html text eol=lf diff=html
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.txt text eol=lf
*.xml text eol=lf
